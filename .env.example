# Copia este ficheiro para .env.local e preenche.

# Número de WhatsApp que recebe os contactos dos botões "Quero a minha landing page"
# e "Começar um projeto". Formato internacional só com dígitos (ex.: 351912345678).
# Sem número, os botões levam para a secção #contacto.
# Depois de mudar, reinicia o `npm run dev` (o valor é embutido no build).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Domínio final do site (sem barra final), usado nos metadados (Open Graph,
# canonical), em robots.txt, sitemap.xml e nos dados estruturados (JSON-LD).
# Ex.: https://landora.pt — sem valor, usa http://localhost:3000.
# Depois de mudar, reinicia o `npm run dev` (o valor é embutido no build).
NEXT_PUBLIC_SITE_URL=

# Loja Shopify (opcional) — liga o botão "Comprar plano" ao checkout da
# Shopify via Storefront API. Sem estas variáveis o botão não aparece e o
# site funciona exatamente como antes; "Pedir orçamento" mantém-se sempre.
# Domínio da loja (ex.: a-tua-loja.myshopify.com).
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
# Token PÚBLICO de acesso Storefront (canal "Headless" no admin da Shopify).
# É embutido no build e visível no browser — nunca uses aqui o token de admin.
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
# ID da variante de cada plano (Admin → Produtos → variante → "..." → Copiar ID,
# ou o número no fim do URL da variante). Cada plano é ativado individualmente.
NEXT_PUBLIC_SHOPIFY_VARIANT_ESSENCIAL=
NEXT_PUBLIC_SHOPIFY_VARIANT_PROFISSIONAL=
NEXT_PUBLIC_SHOPIFY_VARIANT_CRESCIMENTO=
